<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Settings"
        android:textColor="@color/text_primary_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDeviceId"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="Device ID"
        app:boxStrokeColor="@color/outline_dark"
        app:hintTextColor="@color/text_secondary_dark"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSettingsDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_dark" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRfidPower"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="RFID Power (5-30 dBm)"
        app:boxStrokeColor="@color/outline_dark"
        app:hintTextColor="@color/text_secondary_dark"
        app:layout_constraintTop_toBottomOf="@id/tilDeviceId">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSettingsRfidPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/text_primary_dark" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Operation Mode"
        android:textColor="@color/text_secondary_dark"
        app:layout_constraintTop_toBottomOf="@id/tilRfidPower"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvModeLabel">

        <RadioButton
            android:id="@+id/rbBagWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bag Weight"
            android:textColor="@color/text_primary_dark"
            android:buttonTint="@color/accent_red" />

        <RadioButton
            android:id="@+id/rbTagAssignment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tag Assignment"
            android:textColor="@color/text_primary_dark"
            android:buttonTint="@color/accent_red" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Save &amp; Restart"
        app:backgroundTint="@color/accent_red"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/rgMode" />

</androidx.constraintlayout.widget.ConstraintLayout>
