<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Settings"
        android:textColor="@color/text_primary_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDeviceId"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="Scanner ID (Integer)"
        app:boxStrokeColor="@color/outline_dark"
        app:hintTextColor="@color/text_secondary_dark"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSettingsDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/text_primary_dark" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilStationId"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Station ID (Integer)"
        app:boxStrokeColor="@color/outline_dark"
        app:hintTextColor="@color/text_secondary_dark"
        app:layout_constraintTop_toBottomOf="@id/tilDeviceId">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSettingsStationId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/text_primary_dark" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Save &amp; Restart"
        app:backgroundTint="@color/accent_red"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/tilStationId" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnassignMode"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_open_unassign"
        android:textColor="@color/text_muted"
        app:layout_constraintTop_toBottomOf="@id/btnSaveSettings" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReassignMode"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_open_reassign"
        android:textColor="@color/text_muted"
        app:layout_constraintTop_toBottomOf="@id/btnUnassignMode" />

</androidx.constraintlayout.widget.ConstraintLayout>