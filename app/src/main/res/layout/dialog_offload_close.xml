<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <!-- One color per classification so the receipt outcome is unmistakable at a glance:
         Short = amber (fewer than expected), Complete = green, Over = red (more than expected). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseShort"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:text="@string/status_label_short"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/warning"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseComplete"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/status_label_complete"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/success"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseOver"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/status_label_over"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/danger"
        app:cornerRadius="14dp" />
</LinearLayout>
