<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/guide/topics/data/autobackup for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The encrypted broker credential must never leave the device: its Keystore key does not
         back up, so a restored ciphertext is undecryptable garbage — and the Schema 4.1 handoff
         requires the credential to be excluded from backup outright. -->
    <exclude domain="sharedpref" path="ppnam_secure_credentials.xml" />
</full-backup-content>
